########################
### Archwiki version ###
########################
#
# https://wiki.archlinux.org/title/Ncmpcpp#With_album_art
#
# Displays currently playing song info in a notification, with album art.
function archwiki_version() {
	local music_dir="$MUSIC_DIR"
	local previewdir="$PREVIEW_DIR"
	local filename="$(mpc --format "$music_dir"/%file% current)"
	local previewname="$previewdir/$(mpc --format %album% current | base64).png"
	
	# `ffmpeg` will fail with an error if the song file has no cover metadata.  So disabling error
	# protection is necessary for the script to continue.  The error has no effect on functionality.
	set +e

	# If the image already exists, do nothing.  If it does not, create it with `ffmpeg`.
	[ -e "$previewname" ] || ffmpeg -y -i "$filename" -an -vf scale=128:128 "$previewname" > /dev/null 2>&1

	# Re-enable error protection.
	set -e
	
	# Send notification.
	notify-send \
		--replace-id=27072 \
		"Now Playing" \
		"$(mpc --format '%title% \n%artist% - %album%' current)" \
		--icon="$previewname"

	return
}


############
### Main ###
############
#
function main() {
	local some_variable
}


