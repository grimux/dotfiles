#!/usr/bin/bash
#
# A script to toggle autologin and autostartx
#

# e - script stops on error
# u - error if undefined variable
# o pipefail - script fails if command piped fails
# x - output each line (debug)
#
#set -euox pipefail
set -euo pipefail

# Autologin variables
drop_in_file=/etc/systemd/system/getty@tty1.service.d/autologin.conf
backup_file=$HOME/.config/system-wide/autologin.conf

# Autostartx variables
#shell_profile="$HOME/.zshrc"
#shell_profile="${ZDOTDIR:-$HOME}/.zshrc"
shell_profile="${ZDOTDIR:-$HOME}/.zprofile"
search_term_sed='\/dev\/tty1'
search_term_grep="^#.*/dev/tty1"

# Set initial status for flags.
autologin_status=0
autostartx_status=0

# Help Section
function help_section() {
	# Variable to store the name of the script.  For convenience.
	local sn=$(basename $0)

	# Help Message.  4 space offset.
	echo "A script to toggle automatic PC login."
	echo
	echo "usage:"
	echo "    $(basename $0) (option) [command]"
	echo
	echo "options:"
	echo "     s        : Show current status."
	echo "     h        : Print this help screen."
	echo "     t        : Toggle the status."
	echo
	echo "commands:"
	echo "     on       : Turn on autologin/autostartx."
	echo "     off      : Turn off autologin/autostartx."
	echo "     toggle   : Toggle the current status."
	echo
	echo "This script relies upon $backup_file.  Please make sure it is present."
	echo
	echo "Check this link for more details:"
	echo
	echo "     https://wiki.archlinux.org/title/Getty#Automatic_login_to_virtual_console"
	echo
}

function does_config_exist() {
	local file
	file="$backup_file"

	if [ ! -f "$file" ]; then
		echo "Drop-in file for autologin not found!"
		echo "Should be here: $backup_file"
		exit 1
	fi
}

# Enable autologin by copying the file from my .config to the system location
function autologin_enable() {
	sudo cp "$backup_file" "$drop_in_file"
}

# Disable autologin by removing the system drop in file
function autologin_disable() {
	sudo rm "$drop_in_file"
}

# Enable autostartx by uncommenting a line in .zprofile
# sed expression will search for $search_term_sed, and remove the leading #.
function autostartx_enable() {
	sed \
		--in-place \
		--expression="/$search_term_sed/s/^#//g" \
		$shell_profile

}

# Disable autostartx by commenting out a line in .zprofile
# sed expression will search for $search_term_sed, add # to the beginning of the line.
function autostartx_disable() {
	sed \
		--in-place \
		--expression="/$search_term_sed/s/^/#/g" \
		$shell_profile
}

# Check the status of autologin
# Return 1 if autologin is enabled
# Return 0 if autologin is disabled
function get_autologin_status() {
	if [ -f $drop_in_file ]; then
		echo 1
	else
		echo 0
	fi
}

# Check the status of autostartx
# Return 1 if autostartx is enabled
# Return 0 is autostartx is disabled
function get_autostartx_status() {
	local is_line_commented

	grep "$search_term_grep" $shell_profile > /dev/null
	is_line_commented=$?

	if [ "$is_line_commented" -eq 1 ]; then
		echo 1
	else
		echo 0
	fi
}

# Get current status of autologin/startx.
function get_status() {
	# Check status of autologin
	autologin_status=$(get_autologin_status)

	# Check status of autostartx
	autostartx_status=$(get_autostartx_status)
}



# Get the status of both autologin and autostartx
# Display the results
function print_status() {
	echo "=== Current Status ==="

	# Logic to control message for autologin status
	if [ "$autologin_status" -eq 1 ]; then
		echo "Autologin: enabled"
	else
		echo "Autologin: disabled"
	fi

	# Logic to control message for autostartx status
	if [ "$autostartx_status" -eq 1 ]; then
		echo "Autostartx: enabled"
	else
		echo "Autostartx: disabled"
	fi
}

function autologin_on() {
	# Check if autologin/autostartx is already enabled.
	if [ "$autologin_status" -eq 1 ] || [ "$autostartx_status" -eq 1 ]; then
		echo "Autologin and autostartx is already enabled."
		echo "Cancelling..."
		exit 1
	fi

	# Display message.
	echo "Enabling autologin..."

	# Add the drop-in file
	autologin_enable && echo "Done."

	# Display message
	echo "Enabling autostartx..."

	# Enable autostartx
	autostartx_enable && echo "Done."
}

function autologin_off() {
	# Check if autologin/autostartx is already disabled.
	if [ "$autologin_status" -eq 0 ] || [ "$autostartx_status" -eq 0 ]; then
		echo "Autologin and autostartx is already disabled."
		echo "Cancelling..."
		exit 1
	fi
	# Display message.
	echo "Disabling autologin..."

	# Remove the drop-in file
	autologin_disable && echo "Done."

	# Display message.
	echo "Disabling autostartx..."

	# Disable autostartx
	autostartx_disable && echo "Done."
}

function autologin_toggle() {
	# Look for drop-in file
	if [ -f $drop_in_file ]; then
		autologin_off
	else
		autologin_on
	fi
}

# Entry Point
# Get arguments
function get_arguments() {
	while getopts ":sht" option; do
		case $option in
			s)
				get_status
				exit
				;;
			h)
				help_section
				;;
			t)
				toggle_login
				;;
			\?)
				echo "Error: Invalid option"
				exit
				;;
		esac
	done
}

function main() {
	local user_command
	user_command="${1:-status}"

	case "$user_command" in
		off)
			autologin_off;;
		on)
			autologin_on;;
		toggle)
			autologin_toggle;;
		status)
			print_status;;
		\?)
			echo "Error: Invalid command!"
			help_section
			exit 1;;
	esac

}

# Get status of autologin.
get_status

# Get arguments (options) passed to the script.
get_arguments "$@"

# Strip out any options.
shift $((OPTIND-1))


# Call to main function.
main "$@"

# All done
exit
