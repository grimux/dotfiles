#!/usr/bin/env bash
#
############
### Info ###
############
#
### Description ###
# A script for controlling redshift to help with my light sensitivities and migraines.
#
### How it works ###
# It utilizes two configuration files, a normal mode and a hurt mode.  The script will
# link the proper config file to redshift's default config file, "redshift.conf".
# This ensures that settings are saved between X sessions and reboots.  Settings will
# only change when this script is run with the proper arguments.


###################
### Fail Events ###
###################
# e - script stops on error
# u - error if undefined variable
# o pipefail - script fails if command piped fails
# x - output each line (debug)
#
#set -euox pipefail
set -euo pipefail

# Source the main script config file.
# Its location is exported by the shell profile.
# HOME/.config/script_config.sh
if [ ! -f "$SCRIPT_CONFIG" ]; then
	echo "The configuration script is missing!"
	echo "Should be at: \"HOME/.config/script_config.sh\"."
	exit 1
else
	source "$SCRIPT_CONFIG"
fi

# Sourced Variables
hurt_conf_file="$HURT_CONF"
normal_conf_file="$OKAY_CONF"


##############
### Config ###
##############
#
### Files ###
base_dir="$HOME/.config/redshift"
conf_dir="configs"

# Array of conf files with full path.
conf_files_full=($base_dir/$conf_dir/*)
conf_files_short=($(basename --multiple ${conf_files_full[@]}))

#options=$(basename --multiple ${conf_files_full[@]})

# Preset config profiles.
# These also have a separate file for "high" or "low".
sunglasses_conf_file="sunglasses.conf"

# Default conf file Redshift uses.
# Desired settings are written to this file.
default_conf_file="redshift.conf"

### Call to redshift ###
# Can be either "redshift-gtk" to get the tray icon, or just "redshift".
# call_redshift="redshift"
call_redshift="redshift-gtk"



#################
### Functions ###
#################
#
function usage() {
	echo "Do your eyes \"hurt\" or are they \"okay\"?"
	echo "Or maybe you are using \"sunglasses\"?"
	echo "You can also select which config to use with \"choose\"."
}

# Get the current status.
# It just prints out the config file and doesn't actually get live values.
function get_status() {
	echo "Current status:"
	redshift -p
}

# Set the mode for Redshift, using conf files.
# This function will link the desired mode to Redshift's default conf file "redshift.conf".
function set_redshift_mode() {
	# Local variables.
	local chosen_conf_file="$@"
	local does_conf_exist=0

	# Loop through array of conf files and compare them to the chosen conf file.
	# Sets a flag if the conf exists.
	for file in "${conf_files_short[@]}"; do
		if [[ $file = $chosen_conf_file ]]; then
			does_conf_exist=1
			break
		else
			does_conf_exist=0
		fi
	done

	# Check if the chosen conf file exists within the array.
	# If not, exit.
	if [ "$does_conf_exist" -eq 0 ]; then
		echo "No conf file was found for \"$chosen_conf_file\"."
		exit 1
	fi

	# Kill redshift if it is running.
	kill_redshift

	# Create a link to the mode file.  The link is called "redshift.conf".
	ln \
		--force \
		"$base_dir/$conf_dir/$chosen_conf_file" \
		"$base_dir/$default_conf_file"

	# Start redshift using the default configuration file.  Send all output to null.
	$call_redshift &> /dev/null &
}

# Used to set a configuration file.  Chosen with fzf.
function choose_with_menu() {
	local choice
	local label="Please choose a Redshift configuration file."

	#cd "$base_dir/$conf_dir/"

	choice=$(printf '%s\n' "${conf_files_short[@]}" | fzf --cycle --layout=reverse-list --border=rounded --border-label="$label")
	set_redshift_mode "$choice"
}

function give_output() {
	local mode
	local emoji
	local message

	mode="$1"
}

# If redshift is found running, kill it.
# Multiple instances of redshift running causes settings to stack and monitor flickering.
# So it's important to ensure only one is ever running.
function kill_redshift() {
	if pgrep redshift > /dev/null; then
		killall redshift
	fi
}



############
### Main ###
############
function main() {
	# My current option, passed as an argument.
	local option="$@"

	# Main logic.  Only two possible arguments; "okay" and "hurt".
	case "$option" in
		# If no argument, show status.
		"") usage; echo ; get_status;;

		# If your eyes are hurting.
		hurt|h) echo "Sorry your eyes hurt...  Let me help."; set_redshift_mode "$hurt_conf_file";;

		# Sunglasses mode.
		sunglasses|sun|s) echo "Be sure to put on your shades."; set_redshift_mode "$sunglasses_conf_file";;

		# If your eyes are okay.
		okay|ok|o) echo "You must be feeling better!"; set_redshift_mode "$normal_conf_file";;

		choose|select|c) echo "Please choose a setting."; choose_with_menu;;

		# Anything else entered is not recognized.
		*) echo "Sorry, I don't recognize that command."; usage; exit 1;;
	esac
}


###############
### Testing ###
###############
function testing() {
	# Enable debug output
	set -euox pipefail

	# Local variables
	local option

	# Initialize
	option="$1"

	# Set redshift mode
	set_redshift_mode "$option"

	# Give some terminal output.
	give_output "$option"
}


####################
### Call to main ###
####################
main "$@"
#testing "$1"
