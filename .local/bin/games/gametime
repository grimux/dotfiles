}

# Function to launch Lutris.
# By default it will be minimized by using `wmctrl`.
function launch_lutris() {
	echo "Starting Lutris..."

	# Launch lutris
	lutris &> /dev/null &

	sleep 2

	# Check to see if we should minimize Lutris.
	# Uses wmctrl to minimize Lutris.
	if [ "$minimize_lutris" -eq 1 ]; then
		echo "Minimizing Lutris..."
		# This loop will try running the command until it succeeds.
		until wmctrl -r lutris -b add,hidden; do
			echo "Waiting for lutris to start..."
			sleep 1
		done
	fi

}

# Function to launch the launchers.
# Will send a notification.
# TODO: Add some logic to control which launchers to start.  And determine which way to launch Steam.
function launch_launchers() {
	# Send a notification.
	#notify-send "gametime" "Starting Steam and Lutris..."
	send_notification_simple "start"

	# normal, minimized, big-picture
	if [ "$launch_steam" -eq 1 ]; then
		launch_steam
	fi

	if [ "$launch_lutris" -eq 1 ]; then
		launch_lutris
	fi

	return
}

# Kill the launchers.
# Will check first to see if the process is running or not.
# If we try to `pkill` a process that doesn't exist, the script exits prematurely
function kill_launchers() {
	#notify-send "gametime" "Quiting Steam and Lutris..."
	send_notification_simple "stop"

	# Close Steam.
	#pkill --exact "$steam_process_name"
	if [ "$is_steam_running" -eq 1 ]; then
		echo "Stopping Steam."
		pkill --exact "$steam_process_name"
		echo "Waiting for Steam to close..."
		tail --pid=$steam_process_id --follow /dev/null
	fi

	# Close Lutris.
	#pkill --full "$lutris_process_name"
	if [ "$is_lutris_running" -eq 1 ]; then
		echo "Stopping Lutris"
		pkill --full "$lutris_process_name"
	fi

	return
}

# Choose which launchers to max/minimize using an application, such as dmenu or fzf.
function choose_with_menu() {
	# Declare and initialize variables.
	local choice="null"
	local application="$menu_application"
	local application_arguments="null"

	# Prompt for the menu application.
	local prompt="Launcher: "

	# Array of possible choices.
	local options=(
		"big-picture"
		"lutris"
		"steam"
		"both"
	)

	# Wether to use `dmenu` or `fzf`.
	# Currently, dmenu is the only working one.
	case "$application" in
		"dmenu") application_arguments="-i -l 5 -p $prompt";;
		"fzf") application_arguments="";;
		"zenity") application_arguments="";;
		*) echo "Error: not a recognized menu application"; exit 1;;
	esac

	# Save the choice from the user into this variable.
	choice=$(printf '%s\n' "${options[@]}" | $application $application_arguments)

	# What to do based off the user choice variable.
	case "$choice" in
		"lutris") minimize_lutris=0; minimize_steam=1;;
		"steam") minimize_lutris=1; minimize_steam=0;;
		"big-picture") minimize_lutris=1; minimize_steam=0; use_bigpicture=1;;
		"both") minimize_lutris=0; minimize_steam=0;;
	esac
}

# Silently patch steam with modifications done with steam-metadata-editor
function patch_steam_custom_metadata() {
	echo "Patching Steam metadata..."
	steammetadataeditor --silent
	sleep 1
	steammetadataeditor --silent
}

# Check for already running processes.  Set a flag
function check_processes() {
	echo "Checking for processes..."

	# Run the pgrep command to check for running processes.
	# If the command fails, the process variable is set to 0.
	steam_process_id=$(pgrep --exact "$steam_process_name") || steam_process_id=0
	lutris_process_id=$(pgrep --full "$lutris_process_name") || lutris_process_id=0

	# Check the lutris process.
	# If 0, not running.
	# If running, set to 1.
	if [ "$lutris_process_id" -eq 0 ]; then
		echo "Lutris is not running."
		is_lutris_running=0
	else
		echo "Lutris is running."
		is_lutris_running=1
	fi

	# Check the Steam process.
	# If 0, not running.
	# If running, set to 1.
	if [ "$steam_process_id" -eq 0 ]; then
		echo "Steam is not running."
		is_steam_running=0
	else
		echo "Steam is running."
		is_steam_running=1
	fi

}

function send_notification() {
	local message
	local program
	local title
	local steam_status
	local lutris_status

	status="$1"
	program="$2"
	title="Game Time"

	case "$status" in
		start) message="Starting up: $program".;;
		stop) ;;
		"") ;&
		*) message="Error with notification"; exit 1;;
	esac
}

function send_notification_simple() {
	local message=""
	local title
	local status

	status="$1"
	title="Game Time"

	case "$status" in
		start) message="Starting up game lanuchers...";;
		stop) message="Closing game launchers.";;
		"") ;&
		*) message="Error with notification"; exit 1;;
	esac

	if [ "$status" == "start" ]; then
		[ "$use_bigpicture" -eq 1 ] && message="$message\nStarting Steam in Big Picture mode..."
		[ "$minimize_lutris" -eq 1 ] && message="$message\nLutris will be minimized..."
		[ "$minimize_steam" -eq 1 ] && message="$message\nSteam will be minimized..."
	fi


	#echo "$title:"
	#echo -e "$message"

	notify-send "$title" "$message"
}



############
### Main ###
############
function main() {
	# Check for running processes for Steam and Lutris
	check_processes

	get_arguments "$@"
	shift $((OPTIND-1))

	# If either of them is running, kill it and exit.
	if [ $is_steam_running -eq 1 ] || [ $is_lutris_running -eq 1 ]; then
		kill_launchers
		exit
	fi

	# If choose_interactively mode is set.
	if [ "$choose_interactively" -eq 1 ]; then
		choose_with_menu
	fi

	# Launch the game launchers, according to the flags.
	launch_launchers

	echo "All done!"

	return
}


