##############
### Config ###
##############
use_mangohud=1
use_bigpicture=0

choose_interactively=1
menu_application="dmenu"
#menu_application="fzf"
#menu_application="zenity"

is_steam_running=0
is_lutris_running=0
steam_process_id=0
lutris_process_id=0

launch_lutris=0
launch_steam=1

# Start minimized
minimize_lutris=0
minimize_steam=0


########################
### Global Variables ###
########################
steam_binary="steam-runtime"
steam_process_name="steam"
lutris_process_name="python3 /usr/bin/lutris"


##############################
### Help, arguments, usage ###
##############################
# Get arguments and set flags
function get_arguments() {
	while getopts ":hcmb" option; do
		case $option in
			# What to do if there is an invalid argument.
			\?) echo "Error: Invalid option"; exit 1;;

			# Help section
			h) help_section; exit;;

			# Choose options interactively.
			c) choose_interactively=1;;

			# Start minimized.
			m) minimize_lutris=1; minimize_steam=1;;

			# Use Steam's Big Picture mode.
			b) use_bigpicture=1;;

			# What to do if the argument is missing.
			:) echo "Missing argument"; help_section; exit 1;;

			# Catchall.  If command is not recognized.
			*) usage; exit 1;;
		esac
	done
}

# Help Section
function help_section() {
	echo "A script to launch Lutris and Steam."
	echo
	echo "Syntax: $(basename $0) (options) [-n] <playlist name> [-d] <video directory>"
	echo "options:"
	# Space offset: 19
	echo "     h                   : Print this help screen."
	echo "     c                   : Choose interactively."
	echo "     m                   : Start minimized."
	echo "     b                   : Use Steam's Big Picture mode."
	echo
}

# How to use the script.
function usage() {
	echo "Usage:"
	echo "$(basename $0) (options)"
}


#################
### Functions ###
#################

# Function to launch Steam.
# You can decide if you want it minimized or not, or to use MangoHud or not.
function launch_steam() {
	echo "Starting Steam..."

	local launch_arguments
	local command

	run_command="$steam_binary"
	launch_arguments=("-nochatui" "-nofriendsui")

	# Check if the global flag for big picture mode is set.
	if [ "$use_bigpicture" -eq 1 ]; then
		echo "Using Big Picture mode."
		launch_arguments+=("-bigpicture")
	fi

	if [ "$minimize_steam" -eq 1 ]; then
		echo "Minimizing Steam..."
		launch_arguments+=("-silent")
	fi

	# Check if we should use Mangohud with Steam globally.
	# If so, set the "command" variable to include it.
	if [ "$use_mangohud" -eq 1 ]; then
		echo "Using Mangohud."
		run_command="mangohud $steam_binary"
	fi

	# Silently patch steam with modifications done with steam-metadata-editor
	#patch_steam_custom_metadata

	# Run Steam with its launch arguments.
	$run_command "${launch_arguments[@]}" &> /dev/null &

	return

}

# Old function to launch Steam.  Kept as a backup and while working on the new function.
# You must choose one of the launch options below and uncomment it.
function launch_steam_old() {
	# Silently patch steam with modifications done with steam-metadata-editor
	steammetadataeditor --silent
	sleep 1
	steammetadataeditor --silent

	# Launch steam with no chat or friends list open.
	#steam -nochatui -nofriendsui &> /dev/null &

	# Silent will make it minimized to sys-tray.
	#steam -nochatui -nofriendsui -silent &> /dev/null &

	# Bigpicture will make it start in Big Picture mode.  Great for playing on TV or with controller.
	#steam -nochatui -nofriendsui -bigpicture &> /dev/null &

