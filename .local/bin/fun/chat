############
### Main ###
############
#
function main_old() {
	clear
	local user
	local option
	if [ -n "$USER" ]; then
		user="$USER"
		validate_user "$user"
	else
		# Set user by selecting with a function.
		user="$(select_user)"
	fi

	open_chat "$user"

	# Check if user is blank, if so close chat.
	if [ -z "$user" ]; then
		close_chat "$user"
		break
	fi

	# Set option from the menu.
	option="$(select_option)"

	# Check if option is blank, if so close chat.
	if [ -z "$option" ]; then
		close_chat "$user"
		break
	fi

	# Choose an option from the menu.
	menu_selection "$option"

}

function main() {
	local user=""
	local option=""

	# Loop while the user variable is empty.
	# This protects against an empty user variable.
	while [ -z "$user" ]; do
		clear
		echo "Please select a user."
		user=$(select_user)
	done

	# Loop to control the interactive menu.
	while true; do
		clear
		open_chat "$user"
		option=$(select_option)
		menu_selection "$option"
	done
}


#############
### Start ###
#############
get_arguments "$@"
#testing "$@"
main "$@"
