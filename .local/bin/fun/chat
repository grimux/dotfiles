##############
### Config ###
##############
#
PROGNAME="$(basename $0)"
LOGDIR="$HOME/Documents/writing/$PROGNAME"
LASTMSG="$LOGDIR/last_message.log"
LOGS=($LOGDIR/*)
USEVIM=1


######################
### Initialization ###
######################
#
USERS=(Jake NumberOne Stephanie Olivia Jeffery Angela Frank ?)
MESSAGE=""
USER=""
TODAY="$(date +'%Y-%m-%d')"
TODAYS_LOG="$LOGDIR/$TODAY.log"
MENU_OPTIONS=("msg" "user" "log" "quit")

# If the chat logs directory does not exist, create it.
if [ ! -d "$LOGDIR" ]; then
	mkdir "$LOGDIR"
fi

##################################
### Arguments, Help, and Usage ###
##################################
#
# Get arguments and set flags
function get_arguments() {
	while getopts ":fhu:m:pli" option; do
		case $option in
			# What to do if there is an invalid argument.
			\?) echo "Error: Invalid option"; exit 1 ;;

			# Fast mode.
			f) fast_mode; exit;;

			# Help section
			h) help_section; exit ;;

			# Interactive mode.
			i) interactive_mode; exit;;

			# Print last message.
			l) get_last_message; exit;;

			# Set user.
			u) USER="${OPTARG}";;

			# Message to send.
			m) MESSAGE="${OPTARG}";;

			# Choose a log file to print.
			p) print_log_with_pager; exit;;

			# What to do if the argument is missing.
			:) echo "Missing argument"; help_section; exit 1;;

			# Catchall.  If command is not recognized.
			*) usage; exit 1;;
		esac
	done
}

# Help Section
function help_section() {
	echo "A script chat application for me and my alters."
	echo
	echo "Syntax: $PROGNAME (options) <arguments>"
	echo "options:"
	# Space offset: 5-8
	echo "     h        : Print this help screen."
	echo "     i        : Use interactive mode."
	echo "     l        : Display last message."
	echo "     p        : Choose a log file to view."
	echo
	echo "$PROGNAME can be run in-line to quickly send a message.  Just use the following arguments."
	echo "arguments:"
	echo "     u        : username."
	echo "     m        : Message."
}

# How to use the script.
function usage() {
	echo "$PROGNAME (options)"
}


#################
### Functions ###
#################
#
function open_chat() {
	local user
	local last_message

	user="$1"
	last_message=$(get_last_message)

	echo "Logging into chat: $user"
	echo "Welcome!"
	echo

	echo "----------------"
	echo "| Last Message |"
	echo "----------------"
	echo "$last_message"
	echo "----------------"
	echo

	return
}

function close_chat() {
	local user="$1"
	clear
	echo "Logging out of chat: $user"
	echo "Bye!"
	exit
}

# Write a message as the given user.
function write_message() {
	local user="$1"
	local message

	echo "Enter blank line to cancel."
	echo

	if [ -n "$MESSAGE" ]; then
		message="$MESSAGE"
	else
		#read -p "$user: " message
		message=$(vipe --suffix log)
	fi


	if [ -z "$message" ]; then
		echo "Empty message. Cancelling..."
		return
	fi

	write_log "$user" "$message"

	return
}

# Write chat history to log file.
function write_log() {
	local user
	local message
	local formatted_message
	local today
	local time
	local log_file

	user="$1"
	message="$2"
	today="$TODAY"
	time="$(date +'%I:%M:%S %p')"
	log_file="$LOGDIR/$today.log"

	# Message formatted to be used in the log file.
	formatted_message="$user:\n$message\n$time\n"

	# If today's log file does not exist, make it.
	if [ ! -f "$log_file" ]; then
		touch "$log_file"
	fi

	# Add formatted message to log file.
	echo -e "$formatted_message" >> "$log_file"

	# Update the last message sent.
	echo -e "$formatted_message" > "$LASTMSG"

	return
}

function print_log_in_terminal() {
	local log_file=""
	local today

	today="$TODAY"

	if [ -z "$log_file" ]; then
		log_file="$LOGDIR/$today.log"
	else
		log_file="$@"
	fi

	if [ ! -f "$log_file" ]; then
		echo "No log found for today!"
		read -p "Press Enter to look at old logs."
		log_file=$(choose_with_fzf "Logs" "${LOGS[@]}")
	fi

	echo "------------------"
	echo "| $(basename $log_file) |"
	echo "------------------"

	cat "$log_file"

	return
}

# Print a log using a pager.
function print_log_with_pager() {
	local log_file
	local header
	local pager_arguments=("--use-color")

	#log_file="$LOGDIR/$TODAY.log"

	# Choose a log file to view.
	log_file="$(choose_log)"

	# Check if the chosen log is valid.  If not return with error.
	if [ -z "$log_file" ]; then
		echo "No log chosen."
		return 1
	fi

	# A header to display at the top.
	header="--- $(basename $log_file) ---"

	# Send the header and log file into `less`.
	{ echo -e "$header\n"; cat "$log_file"; } | $PAGER "${pager_arguments[@]}"

	return
}

function choose_log() {
	local all_logs=($LOGDIR/*)
	local chosen_log_file=$(choose_with_fzf "Select a log to view:" "${all_logs[@]}")
	echo "$chosen_log_file"
	return
}

function select_user() {
	local user=$(choose_with_fzf "Select user:" "${USERS[@]}")
	echo "$user"
	return
}

function select_option() {
	local option=$(choose_with_fzf "Current user: $user" "${MENU_OPTIONS[@]}")
	echo "$option"
	return
}


########################
### Helper Functions ###
########################
#
# Choose an option using fzf.
# Arg1 = Prompt
# Arg2 = Array of choices.
function choose_with_fzf() {
	local prompt="${1}"
	shift
	local choices=("${@}")
	local fzf_arguments=" \
		--ignore-case \
		--cycle \
		--border=double \
		--height=50% \
		--layout=reverse-list \
		--margin=5%,2%,2%,5% \
		--info=default"
	local fzf_label="--border-label=$prompt"
	local fzf_preview=""

	printf '%s\n' "${choices[@]}" | fzf $fzf_arguments --preview="$fzf_preview" "$fzf_label"

	return
}

# Old method of getting the last message, using a separate file.
function get_last_message_from_file() {
	local last_message

	while read line; do
		last_message+="$line\n"
	done < "$LASTMSG"

	echo -e "$last_message"

	return
}

# Get the last message from the most recent log file.
# Uses `tail`.
function get_last_message() {
	local last_message
	local today
	local log_file

	today="$TODAY"
	log_file="$LOGDIR/$today.log"

	if [ ! -f "$log_file" ]; then
		last_message="There are no logs for today."
	else
		last_message="$(tail -n4 $log_file)"
	fi

	echo "$last_message"

	return
}

function menu_selection() {
	local choice="$1"

	#open_chat "$user"

	case "$choice" in
		msg) write_message "$user";;
		user) user=$(select_user);;
		log) print_log_with_pager;;
		quit) close_chat "$user";;
	esac

}

function validate_user() {
	local user="$1"
	local is_valid=0

	for item in "${USERS[@]}"; do
		if [ "$user" == "$item" ]; then
			is_valid=1
			break
		fi
	done

	if [ "$is_valid" -eq 0 ]; then
		echo "That is not a valid user."
		exit 1
	fi

}

#########################
### Testing Functions ###
#########################
#
function interactive_mode() {
	local user=""
	local option=""

	# Loop while the user variable is empty.
	# This protects against an empty user variable.
	while [ -z "$user" ]; do
		user=$(select_user)
	done

	# Loop to control the interactive menu.
	while true; do
		open_chat "$user"
		option=$(select_option)
		menu_selection "$option"
	done
}

function fast_mode() {
	local user="none"
	local option=""
	clear

	while true; do
		user=$(select_user)
		[ -z "$user" ] && break
		open_chat "$user"
		menu_selection "msg"
	done
}


